<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>{{bundle_id}}</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>{{license}}</project_license>
  <name>{{display_name}}</name>
  <summary>A fast, keyboard-driven Markdown editor</summary>
  <description>
    <p>
      A Markdown editor with vim keys that shows the document as it will read,
      one window per file.
    </p>
  </description>
  <url type="homepage">{{homepage}}</url>
  <developer id="{{developer_id}}">
    <name>{{maintainer_name}}</name>
  </developer>
  <launchable type="desktop-id">{{bundle_id}}.desktop</launchable>
  <icon type="stock">{{bundle_id}}</icon>
  <provides>
    <binary>{{slug}}</binary>
  </provides>
  <supports>
    <control>keyboard</control>
  </supports>
  <categories>
    <category>Utility</category>
    <category>TextEditor</category>
  </categories>
  <releases>
    <release version="{{version}}" date="{{release_date}}" type="{{release_type}}"/>
  </releases>
  <content_rating type="oars-1.1"/>
</component>
